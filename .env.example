# سر تشفير الجلسات (32 حرف أو أكثر)
NUXT_SESSION_PASSWORD=change-me-to-a-long-random-string-32chars

# Claude API — https://console.anthropic.com
NUXT_ANTHROPIC_API_KEY=
NUXT_ANTHROPIC_MODEL=claude-opus-5

# تطبيق سلة — https://portal.salla.partners
NUXT_SALLA_CLIENT_ID=
NUXT_SALLA_CLIENT_SECRET=
NUXT_SALLA_WEBHOOK_SECRET=
NUXT_SALLA_REDIRECT_URI=http://localhost:3000/api/auth/salla/callback

# وضع التجربة (متجر وهمي) — اجعله false في الإنتاج
NUXT_DEMO_MODE=true

NUXT_PUBLIC_APP_URL=http://localhost:3000
NUXT_PUBLIC_SALLA_APP_STORE_URL=https://s.salla.sa/apps
